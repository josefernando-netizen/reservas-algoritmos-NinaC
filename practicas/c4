// C4: Comparación de búsqueda lineal y binaria para códigos de estudiantes.
// Ejecutar: php busqueda.php

function busquedaLineal(array $datos, int $objetivo): int {
    foreach ($datos as $i => $valor) {
        if ($valor === $objetivo) return $i;
    }
    return -1;
}

function busquedaBinaria(array $datos, int $objetivo): int {
    $izq = 0; $der = count($datos) - 1;
    while ($izq <= $der) {
        $medio = intdiv($izq + $der, 2);
        if ($datos[$medio] === $objetivo) return $medio;
        if ($datos[$medio] < $objetivo) $izq = $medio + 1;
        else $der = $medio - 1;
    }
    return -1;
}

function medir(callable $funcion, array $datos, int $objetivo): float {
    $inicio = hrtime(true);
    $resultado = $funcion($datos, $objetivo);
    $fin = hrtime(true);
    if ($resultado === -1) throw new RuntimeException('No se encontró el estudiante.');
    return ($fin - $inicio) / 1_000_000; // milisegundos
}

$cantidad = 100000;
$codigos = range(100001, 100000 + $cantidad); // datos ordenados
$objetivo = $codigos[$cantidad - 1]; // último registro: escenario desfavorable para lineal

// Calentamiento: una ejecución de cada algoritmo que no se incluye en el promedio.
busquedaLineal($codigos, $objetivo);
busquedaBinaria($codigos, $objetivo);

$resultados = [];
foreach ([ 'Lineal' => 'busquedaLineal', 'Binaria' => 'busquedaBinaria' ] as $nombre => $funcion) {
    $tiempos = [];
    for ($i = 0; $i < 3; $i++) $tiempos[] = medir($funcion, $codigos, $objetivo);
    $resultados[$nombre] = ['tiempos' => $tiempos, 'promedio' => array_sum($tiempos) / 3];
}
$cociente = $resultados['Lineal']['promedio'] / max($resultados['Binaria']['promedio'], 0.000000001);

printf("C4 - BÚSQUEDA DE ESTUDIANTES\nDatos: %s códigos ordenados | Código buscado: %d\n\n", number_format($cantidad), $objetivo);
printf("%-12s | %-12s | %-12s | %-12s | %-12s\n", 'Algoritmo', 'Prueba 1 ms', 'Prueba 2 ms', 'Prueba 3 ms', 'Promedio ms');
foreach ($resultados as $nombre => $r) printf("%-12s | %12.6f | %12.6f | %12.6f | %12.6f\n", $nombre, $r['tiempos'][0], $r['tiempos'][1], $r['tiempos'][2], $r['promedio']);
printf("\nCociente (lineal / binaria): %.2f veces\n", $cociente);
printf("Nota: la búsqueda binaria requiere que los códigos estén ordenados.\n");
