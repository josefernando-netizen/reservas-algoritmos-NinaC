<?php
// C5: Torneo de ordenamientos. Ejecutar: php ordenamientos.php
function burbuja(array $a): array {
    $n = count($a);
    for ($i = 0; $i < $n - 1; $i++) {
        $cambio = false;
        for ($j = 0; $j < $n - $i - 1; $j++) {
            if ($a[$j] > $a[$j + 1]) { [$a[$j], $a[$j + 1]] = [$a[$j + 1], $a[$j]]; $cambio = true; }
        }
        if (!$cambio) break;
    }
    return $a;
}
function mergeSort(array $a): array {
    $n = count($a); if ($n <= 1) return $a;
    $m = intdiv($n, 2);
    $izq = mergeSort(array_slice($a, 0, $m));
    $der = mergeSort(array_slice($a, $m));
    $r = []; $i = 0; $j = 0;
    while ($i < count($izq) && $j < count($der)) {
        if ($izq[$i] <= $der[$j]) $r[] = $izq[$i++]; else $r[] = $der[$j++];
    }
    while ($i < count($izq)) $r[] = $izq[$i++];
    while ($j < count($der)) $r[] = $der[$j++];
    return $r;
}
function quickSort(array $a): array {
    $n = count($a); if ($n <= 1) return $a;
    $p = $a[intdiv($n, 2)]; $menores = []; $iguales = []; $mayores = [];
    foreach ($a as $v) { if ($v < $p) $menores[] = $v; elseif ($v > $p) $mayores[] = $v; else $iguales[] = $v; }
    return array_merge(quickSort($menores), $iguales, quickSort($mayores));
}
function medirOrdenamiento(callable $algoritmo, array $datos): array {
    $inicio = hrtime(true); $ordenados = $algoritmo($datos); $fin = hrtime(true);
    if ($ordenados !== (function($x){ sort($x); return $x; })($datos)) throw new RuntimeException('Ordenamiento incorrecto.');
    return [($fin - $inicio) / 1_000_000, $ordenados];
}

